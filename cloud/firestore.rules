rules_version = '2';

// Do Cloud v1 (Spec 13, section E). Clients never write Firestore directly:
// every write goes through a callable function, which uses the Admin SDK and
// is not bound by these rules. A signed-in device may read its own documents
// (device record, connected assistants, inbox, mirror, entitlement) and
// nothing else. Assistants never touch Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /devices/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /{rest=**} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
