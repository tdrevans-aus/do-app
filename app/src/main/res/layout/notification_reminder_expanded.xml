<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/notification_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/critical_label"
        android:textColor="@color/critical_label"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

    <TextView
        android:id="@+id/notification_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Line2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/action_done"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/notification_action_bg"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="48dp"
            android:padding="4dp"
            android:text="@string/action_done"
            android:textColor="@color/notification_action_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/action_snooze_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/notification_action_bg"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="48dp"
            android:padding="4dp"
            android:text="@string/snooze_default_0"
            android:textColor="@color/notification_action_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/action_snooze_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/notification_action_bg"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="48dp"
            android:padding="4dp"
            android:text="@string/snooze_default_1"
            android:textColor="@color/notification_action_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/action_snooze_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/notification_action_bg"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="48dp"
            android:padding="4dp"
            android:text="@string/snooze_default_2"
            android:textColor="@color/notification_action_text"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/action_stop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/notification_action_bg"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/action_stop"
        android:textColor="@color/notification_action_text"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
