            android:action="android.intent.action.VIEW"
            android:data="do://today"
            android:targetClass="com.evansappstudio.doapp.MainActivity"
            android:targetPackage="com.evansappstudio.doapp">
            <extra
                android:name="com.evansappstudio.doapp.extra.ENTRY"
                android:value="SHORTCUT" />
